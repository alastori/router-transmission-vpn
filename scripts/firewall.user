#!/bin/sh
# /etc/firewall.user — fw4/nft guard: Transmission uses VPN only; UI replies + DNS on LAN.
# Sourced by fw4 on firewall reload. Creates per-UID chain for Transmission.
#
# Works with both OpenVPN (ovpnclient1) and WireGuard (wgclient).
# For WireGuard, an additional rule allows encapsulated UDP packets to the VPN endpoint.

U="$(id -u transmission 2>/dev/null || echo 224)"
RPC_PORT="$(uci -q get transmission.@transmission[0].rpc_port || echo 9091)"
DNSVPN_U="$(id -u dnsmasq_vpn 2>/dev/null || echo 456)"
TRANS_DNS_PORT="$(uci -q get dhcp.transmission_dns.port 2>/dev/null || echo 1053)"
TRANS_DNS_SERVER="$(uci -q get dhcp.transmission_dns.server 2>/dev/null | awk 'NR==1 { print $1 }')"

# Auto-detect client VPN interface. Do not match wgserver.
IF="$(ip -o -4 addr show | awk '{print $2}' | grep -m1 -E '^(wgclient[0-9]*|ovpnclient[0-9]*|tun[0-9]*)$')"
if [ -z "$IF" ]; then
  IF=wgclient
  logger -t firewall.user "WARNING: No VPN interface found, defaulting to $IF"
fi

case "$TRANS_DNS_PORT" in
  ''|*[!0-9]*)
    logger -t firewall.user "ERROR: invalid Transmission DNS redirect port '$TRANS_DNS_PORT'"
    TRANS_DNS_PORT=""
    ;;
esac

case "$TRANS_DNS_SERVER" in
  "") ;;
  *[!0-9.]*)
    logger -t firewall.user "ERROR: invalid Transmission DNS server '$TRANS_DNS_SERVER'"
    TRANS_DNS_SERVER=""
    ;;
esac

if [ -n "$TRANS_DNS_PORT" ] && [ -n "$TRANS_DNS_SERVER" ]; then
  # Redirect only Transmission's local DNS lookups to the private resolver.
  # This keeps the shared LAN/router dnsmasq instance on normal direct DNS.
  if nft list chain inet fw4 transmission_dns_redirect >/dev/null 2>&1; then
    nft flush chain inet fw4 transmission_dns_redirect
  else
    nft add chain inet fw4 transmission_dns_redirect '{ type nat hook output priority -100; policy accept; }'
  fi
  nft add rule inet fw4 transmission_dns_redirect meta skuid "$U" udp dport 53 counter redirect to :"$TRANS_DNS_PORT"
  nft add rule inet fw4 transmission_dns_redirect meta skuid "$U" tcp dport 53 counter redirect to :"$TRANS_DNS_PORT"

  # Route the private resolver's upstream DNS through the VPN table and reject
  # DNS fallback if the VPN route disappears.
  ip rule del uidrange "$DNSVPN_U-$DNSVPN_U" lookup 1001 2>/dev/null
  ip rule add uidrange "$DNSVPN_U-$DNSVPN_U" lookup 1001 priority 98

  if nft list chain inet fw4 transmission_dns_vpn >/dev/null 2>&1; then
    nft flush chain inet fw4 transmission_dns_vpn
  else
    nft add chain inet fw4 transmission_dns_vpn
  fi
  nft add rule inet fw4 transmission_dns_vpn oifname "$IF" ip daddr "$TRANS_DNS_SERVER" udp dport 53 counter accept
  nft add rule inet fw4 transmission_dns_vpn oifname "$IF" ip daddr "$TRANS_DNS_SERVER" tcp dport 53 counter accept
  nft add rule inet fw4 transmission_dns_vpn udp dport 53 counter reject
  nft add rule inet fw4 transmission_dns_vpn tcp dport 53 counter reject

  nft list chain inet fw4 output | grep -q "meta skuid $DNSVPN_U .* jump transmission_dns_vpn" || \
    nft insert rule inet fw4 output position 0 meta skuid "$DNSVPN_U" counter jump transmission_dns_vpn
fi

# Create/refresh the per-UID chain
if nft list chain inet fw4 transmission_vpn >/dev/null 2>&1; then
  nft flush chain inet fw4 transmission_vpn
else
  nft add chain inet fw4 transmission_vpn
fi

# UI replies to LAN (+ guest if present)
nft add rule inet fw4 transmission_vpn tcp sport $RPC_PORT oifname "br-lan" counter accept
[ -d /sys/class/net/br-guest ] && \
nft add rule inet fw4 transmission_vpn tcp sport $RPC_PORT oifname "br-guest" counter accept

# DNS to the normal router resolver is allowed only when the private
# Transmission DNS resolver is not configured.
if [ -z "$TRANS_DNS_PORT" ] || [ -z "$TRANS_DNS_SERVER" ]; then
  nft add rule inet fw4 transmission_vpn oifname "br-lan" udp dport 53 counter accept
  nft add rule inet fw4 transmission_vpn oifname "br-lan" tcp dport 53 counter accept
fi

# Loopback. When private DNS is configured, allow the redirected DNS port but
# reject direct fallback to the normal local resolver on :53.
if [ -n "$TRANS_DNS_PORT" ] && [ -n "$TRANS_DNS_SERVER" ]; then
  nft add rule inet fw4 transmission_vpn oifname "lo" udp dport "$TRANS_DNS_PORT" counter accept
  nft add rule inet fw4 transmission_vpn oifname "lo" tcp dport "$TRANS_DNS_PORT" counter accept
  nft add rule inet fw4 transmission_vpn oifname "lo" udp dport 53 counter reject
  nft add rule inet fw4 transmission_vpn oifname "lo" tcp dport 53 counter reject
fi
nft add rule inet fw4 transmission_vpn oifname "lo" counter accept

# VPN egress for peers + trackers
nft add rule inet fw4 transmission_vpn oifname "$IF" counter accept

# WireGuard encapsulated traffic to VPN endpoint
# When Transmission sends through wgclient, the kernel encrypts and sends the
# WireGuard UDP packet to the endpoint via eth0. Without this rule, the nft chain
# sees UID 224 traffic on eth0 (not wgclient) and rejects it.
VPNEP="$(uci -q get network.wgpeer0.endpoint_host)"
VPNPORT="$(uci -q get network.wgpeer0.endpoint_port || echo 51820)"
if [ -n "$VPNEP" ]; then
  # Validate endpoint is an IP address or hostname (prevent injection)
  case "$VPNEP" in
    *[!a-zA-Z0-9._:-]*) logger -t firewall.user "ERROR: invalid endpoint_host '$VPNEP'"; VPNEP="" ;;
  esac
fi
[ -n "$VPNEP" ] && \
nft add rule inet fw4 transmission_vpn udp dport "$VPNPORT" ip daddr "$VPNEP" counter accept comment \"WireGuard-encap\"

# Fail-closed: reject everything else
nft add rule inet fw4 transmission_vpn counter reject

# Ensure jump at top of OUTPUT for Transmission UID
nft list chain inet fw4 output | grep -q "meta skuid $U .* jump transmission_vpn" || \
  nft insert rule inet fw4 output position 0 meta skuid $U counter jump transmission_vpn

# Route all Transmission UID traffic through VPN routing table
# bind_address_ipv4 only affects peer sockets, not tracker HTTP/UDP connections.
# Without this rule, tracker connections use the main routing table.
ip rule del uidrange "$U-$U" lookup 1001 2>/dev/null
ip rule add uidrange "$U-$U" lookup 1001 priority 99

# Exempt LAN/guest destinations so web UI replies (SYN+ACK from UID 224)
# are not policy-routed out wgclient. Without these, LAN clients cannot
# reach the Transmission web UI on :9091.
ip rule del to 192.168.8.0/24 uidrange "$U-$U" lookup main 2>/dev/null
ip rule add to 192.168.8.0/24 uidrange "$U-$U" lookup main priority 90
ip rule del to 192.168.9.0/24 uidrange "$U-$U" lookup main 2>/dev/null
ip rule add to 192.168.9.0/24 uidrange "$U-$U" lookup main priority 91
