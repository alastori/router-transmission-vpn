#!/bin/sh
# Keep router DNS upstream traffic on the WireGuard client path.
# dnsmasq itself is not UID 224, so Transmission's UID kill switch does not
# govern tracker DNS lookups made through the local router resolver.

[ "${INTERFACE:-}" = "wgclient" ] || exit 0

VPN_DNS="$(uci -q get network.wgclient.dns 2>/dev/null | awk 'NR==1 { print $1 }')"
[ -n "$VPN_DNS" ] || VPN_DNS="$(uci -q get dhcp.@dnsmasq[0].server 2>/dev/null | awk 'NR==1 { print $1 }')"

if [ -z "$VPN_DNS" ]; then
  logger -t vpn-dns-routes "WARNING: no wgclient DNS configured; skipping route update"
  exit 0
fi

case "$VPN_DNS" in
  *[!0-9.]*)
    logger -t vpn-dns-routes "ERROR: invalid VPN DNS '$VPN_DNS'"
    exit 0
    ;;
esac

case "${ACTION:-}" in
  ifup|ifupdate)
    ip route replace "$VPN_DNS/32" dev wgclient table main
    logger -t vpn-dns-routes "routed $VPN_DNS/32 through wgclient"
    ;;
  ifdown)
    ip route replace blackhole "$VPN_DNS/32" table main
    logger -t vpn-dns-routes "blackholed $VPN_DNS/32 after wgclient down"
    ;;
esac
